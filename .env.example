# Optional public Supabase configuration. Copy to .env.development.local or
# .env.android-test.local for tests, .env.production.local for production.
# Leave all three empty to keep synchronization unconfigured.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ENVIRONMENT=
# ENVIRONMENT must be "test" in development/android-test, "production" in production.
# Production also requires SAMHAIN_SUPABASE_PRODUCTION_URL in the build/release environment.
# Never put a secret key, service_role JWT, password, access/refresh token here.
