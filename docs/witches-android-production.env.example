# Copy the VITE_* lines to .env.production.local in the Witches clone.
# Set the two SAMHAIN_API_PRODUCTION_* values independently in the release environment.
# Replace the HTTPS origin before building. Never put MongoDB or private credentials here.
VITE_SAMHAIN_API_URL=https://REPLACE_WITH_WITCHES_API_HOST
VITE_SAMHAIN_API_ENVIRONMENT=production
VITE_SAMHAIN_API_DESTINATION_ID=c01664f7-85df-46c2-9a4b-45b1f9e653dc
SAMHAIN_API_PRODUCTION_URL=https://REPLACE_WITH_WITCHES_API_HOST
SAMHAIN_API_PRODUCTION_DESTINATION_ID=c01664f7-85df-46c2-9a4b-45b1f9e653dc
