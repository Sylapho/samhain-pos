# Copy to a protected file outside Git before deployment. Never place real credentials in this file.
# The API uses a dedicated MongoDB writer account on samhain_witches.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
MONGODB_URI=REPLACE_WITH_WITCHES_MONGODB_URI
MONGODB_DATABASE=samhain_witches
MONGODB_TLS=true
TRUSTED_PROXIES=REPLACE_WITH_ACTUAL_PROXY_CIDR
READINESS_NETWORKS=REPLACE_WITH_ACTUAL_READINESS_CIDR
CORS_ORIGINS=
LOG_LEVEL=info
API_AUTH_ENABLED=true
API_DESTINATION_ID=c01664f7-85df-46c2-9a4b-45b1f9e653dc
API_JWT_ISSUER=REPLACE_WITH_WITCHES_API_HTTPS_ISSUER
API_JWT_AUDIENCE=REPLACE_WITH_WITCHES_API_AUDIENCE
API_SIGNING_KEY_ID=REPLACE_WITH_WITCHES_KEY_ID
API_SIGNING_PRIVATE_KEY_FILE=/run/keys/api-signing.pem
API_AUTH_ENCRYPTION_KEY_FILE=/run/keys/api-encryption.key
OIDC_ISSUER=REPLACE_WITH_EXISTING_KEYCLOAK_ISSUER
OIDC_AUDIENCE=REPLACE_WITH_WITCHES_MANAGER_AUDIENCE
OIDC_JWKS_URI=REPLACE_WITH_EXISTING_KEYCLOAK_JWKS_URI
OIDC_ALGORITHM=RS256
OIDC_CLIENT_ID=REPLACE_WITH_WITCHES_PUBLIC_CLIENT_ID
OIDC_AUTHORIZATION_ENDPOINT=REPLACE_WITH_EXISTING_KEYCLOAK_AUTHORIZATION_ENDPOINT
OIDC_TOKEN_ENDPOINT=REPLACE_WITH_EXISTING_KEYCLOAK_TOKEN_ENDPOINT
OIDC_REDIRECT_URI=fr.samhain.witches:/oauth2redirect
OIDC_SCOPES=openid REPLACE_WITH_AUDIENCE_SCOPE
