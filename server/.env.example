# Fictitious local database only. Copy to server/.env; never use this for production.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27019/
MONGODB_DATABASE=samhain_test_local
# Plaintext is only accepted for a local development/test database.
MONGODB_TLS=false
MONGODB_POOL_MIN=0
MONGODB_POOL_MAX=10
MONGODB_CONNECT_TIMEOUT_MS=3000
MONGODB_SELECTION_TIMEOUT_MS=3000
MONGODB_SOCKET_TIMEOUT_MS=5000
MONGODB_OPERATION_TIMEOUT_MS=5000
READINESS_TIMEOUT_MS=2000
REQUEST_TIMEOUT_MS=25000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576
RESPONSE_LIMIT_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
# Literal peer IPs/CIDRs only. Required explicitly in production, never use 0.0.0.0/0.
TRUSTED_PROXIES=
READINESS_NETWORKS=127.0.0.1,::1
# Empty disables browser access. Explicit HTTPS origins only in production.
CORS_ORIGINS=
LOG_LEVEL=info
