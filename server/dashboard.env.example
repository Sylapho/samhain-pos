# Copy to .env.dashboard; use a read-only account (samhain_reader_v1).
MONGODB_URI=
MONGODB_DATABASE=
DASHBOARD_PORT=4310
# Single festival: use your real API scope and the actual Thursday (YYYY-MM-DD).
DASHBOARD_ORGANIZATION_ID=
DASHBOARD_FESTIVAL_ID=
DASHBOARD_FESTIVAL_START_DATE=
DASHBOARD_REFRESH_SECONDS=60
DASHBOARD_STALE_MINUTES=10
# Optional positive integer amounts in cents. Empty means no objective displayed.
DASHBOARD_DAILY_GOAL_CENTS=
DASHBOARD_FESTIVAL_GOAL_CENTS=
