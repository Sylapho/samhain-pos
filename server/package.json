{
  "name": "@samhain/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.integration --test integration/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env src/persistence/cli.ts migrate",
    "db:verify": "node --env-file-if-exists=.env src/persistence/cli.ts verify",
    "db:roles": "node --env-file-if-exists=.env src/persistence/cli.ts roles",
    "db:verify-runtime": "node --env-file-if-exists=.env src/persistence/cli.ts verify-runtime",
    "db:audit": "node --env-file-if-exists=.env src/persistence/cli.ts audit"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
