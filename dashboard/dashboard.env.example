# Copy outside the repository, for example /opt/samhain-deploy/dashboard.env.
# Replace with a separate user having only the samhain_reader_v1 role on samhain_pos.
# URI-encode special characters in its password. Never use the API's writer account.
MONGODB_URI=mongodb://samhain_dashboard:REPLACE_ENCODED_PASSWORD@samhain-mongo:27017/samhain_pos?authSource=samhain_pos&replicaSet=samhain-rs&tls=true
MONGODB_DATABASE=samhain_pos
# Required. Copy the actual organization/festival UUIDs used by the API.
DASHBOARD_ORGANIZATION_ID=
DASHBOARD_FESTIVAL_ID=
# Actual Thursday of the festival, YYYY-MM-DD. No business date is supplied by default.
DASHBOARD_FESTIVAL_START_DATE=
DASHBOARD_REFRESH_SECONDS=60
DASHBOARD_STALE_MINUTES=10
DASHBOARD_DAILY_GOAL_CENTS=
DASHBOARD_FESTIVAL_GOAL_CENTS=
