# Copy outside the repository, for example /opt/samhain-witches-deploy/dashboard.env.
# Replace with a separate user having only the samhain_reader_v1 role on samhain_witches.
# URI-encode special characters in its password. Never use the API's writer account.
MONGODB_URI=mongodb://samhain_witches_dashboard:REPLACE_ENCODED_PASSWORD@samhain-mongo:27017/samhain_witches?authSource=samhain_witches&replicaSet=samhain-rs&tls=true
MONGODB_DATABASE=samhain_witches
