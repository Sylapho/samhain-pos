{
  "name": "samhain-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "android:add": "pnpm android:add:production",
    "android:add:test": "pnpm build:android:test && cap add android && node scripts/install-android-usb-printer.mjs",
    "android:add:production": "pnpm build:android:production && cap add android && node scripts/install-android-usb-printer.mjs",
    "android:sync": "pnpm android:sync:production",
    "android:sync:test": "pnpm build:android:test && cap sync android && node scripts/install-android-usb-printer.mjs",
    "android:sync:production": "pnpm build:android:production && cap sync android && node scripts/install-android-usb-printer.mjs",
    "android:open": "cap open android",
    "build:android-test": "pnpm build:android:test",
    "build:android:test": "tsc -b && vite build --mode android-test",
    "build:android:production": "tsc -b && vite build --mode production",
    "android:install-usb-printer": "node scripts/install-android-usb-printer.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "^16.0.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "@eslint/js": "^9.0.0"
  }
}
